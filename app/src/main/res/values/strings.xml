    <string name="desc_weather_notif">Notifies you in the morning when hot weather raises your daily goal.</string>
    <string name="set_exact_alarm">Prefer exact alarms</string>
    <string name="desc_exact_alarm">Uses exact timing when permitted; turn off to save battery.</string>
    <string name="set_custom_interval">Custom reminder interval</string>
    <string name="desc_custom_interval">Use a fixed interval instead of calculating from your day and goal.</string>
    <string name="set_custom_interval_val">Interval</string>
    <string name="desc_custom_interval_val">Fixed minutes between reminders (15–240 min).</string>
    <string name="set_notif_second_ml">Notification 2nd quick button</string>
    <string name="desc_notif_second_ml">Volume added by the second action button on notifications.</string>
    <string name="desc_cup">Default glass volume added on single tap, widget, and Quick Settings tile.</string>
    <string name="set_cup_presets">Glass presets</string>
    <string name="desc_cup_presets">Tap a chip to remove (min 1) or add a new preset (50–2000 ml, max 8).</string>
    <string name="set_add_preset_hint">New amount (50–2000)</string>
    <string name="set_widget_amounts">Widget quick-add buttons</string>
    <string name="desc_widget_amounts">Extra volumes shown next to your default glass on the home widget (max 3).</string>
    <string name="set_tile_toast">Quick Settings confirmation</string>
    <string name="desc_tile_toast">Shows a brief toast message when adding water from the Quick Settings tile.</string>
    <string name="desc_theme">Choose system, light, or dark appearance.</string>
    <string name="desc_language">Switch app language immediately without changing device settings.</string>
    <string name="desc_unit">Display volumes in milliliters (ml) or fluid ounces (fl oz).</string>
    <string name="desc_motion">Animates a gentle fill ripple in the orb whenever you add water.</string>
    <string name="set_water_wave">Continuous water waves</string>
    <string name="desc_water_wave">Animates calm waves inside the orb; turn off for reduced motion.</string>
    <string name="set_overflow_effect">Goal overflow effect</string>
    <string name="desc_overflow_effect">Shows glowing overflow ring and droplets when you exceed 100%.</string>
    <string name="set_show_hints">Discovery hints</string>
    <string name="desc_show_hints">Shows the long-press tip on the main add button for new sessions.</string>
    <string name="set_undo_duration">Undo banner duration</string>
    <string name="desc_undo_duration">How long the undo pill stays visible after logging water (1–10 s).</string>
    <string name="set_ml_per_kg">Water per kg</string>
    <string name="desc_ml_per_kg">Base formula multiplier per kilogram of body weight (15–50 ml/kg).</string>
    <string name="set_min_goal">Minimum automatic goal</string>
    <string name="desc_min_goal">Floor for the automatically calculated daily goal (500–3000 ml).</string>
    <string name="set_goal_warn_threshold">High goal warning threshold</string>
    <string name="desc_goal_warn_threshold">Shows a safety warning when your goal exceeds this amount.</string>
    <string name="set_pace_tolerance">Pace tolerance</string>
    <string name="desc_pace_tolerance">Margin around expected intake still considered \"on pace\" (0–500 ml).</string>
    <string name="set_default_stats_days">Default chart period</string>
    <string name="desc_default_stats_days">Initial time window selected when opening the Charts tab.</string>
    <string name="set_history_days">History length</string>
    <string name="desc_history_days">Number of past days displayed on the History tab (7–365 days).</string>
    <string name="set_streak_window">Streak calculation window</string>
    <string name="desc_streak_window">Maximum lookback days counted for consecutive goal streaks (30–365 days).</string>
    <string name="set_min_reminder">Minimum reminder amount</string>
    <string name="desc_min_reminder">Smallest amount a reminder will suggest you drink (50–500 ml).</string>
    <string name="set_max_reminder">Maximum reminder amount</string>
    <string name="desc_max_reminder">Largest amount a reminder will suggest at once (100–2000 ml, never below the minimum).</string>
    <string name="set_max_hints">Hint display count</string>
    <string name="desc_max_hints">How many app launches the long-press tip is shown for (1–10). Has no effect when hints are turned off.</string>
    <string name="set_network_timeout">Network timeout</string>
